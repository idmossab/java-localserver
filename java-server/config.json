{
  "host": "0.0.0.0",
  "ports": [8080],
  "default_server": 0,
  "client_body_limit_bytes": 1048576,
  "error_pages": {
    "400": "error_pages/400.html",
    "403": "error_pages/403.html",
    "404": "error_pages/404.html",
    "405": "error_pages/405.html",
    "413": "error_pages/413.html",
    "500": "error_pages/500.html"
  },
  "routes": [
    {
      "path": "/",
      "root": "www",
      "index": "index.html",
      "methods": ["GET"],
      "autoindex": false
    }
  ],
  "cgi": {
    ".py": "/usr/bin/python3"
  }
}
