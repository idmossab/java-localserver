  "client_body_limit_bytes": 1048576,
  "error_pages": {
    "400": "errors/400.html",
    "403": "errors/403.html",
    "404": "errors/404.html",
    "500": "errors/500.html"
  },
  "routes": {
    "/": {
      "GET": "HomeHandler"
    },
